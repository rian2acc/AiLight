<Window
    x:Class="AIlight.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AIlight — Einstellungen"
    Width="940"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{DynamicResource Font.Ui}"
    Foreground="{DynamicResource Brush.Text}"
    PreviewKeyDown="OnWindowKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    SnapsToDevicePixels="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--
      Drei Spalten: schmale Navigation links, eine Seite rechts, alles in einer
      Karte. Kein Systemrahmen — eigener Streifen zum Ziehen, eigene Knöpfe.
    -->

    <Grid x:Name="Root" Margin="18">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="0" />
        </Grid.RenderTransform>
        <Border Style="{StaticResource Chrome.ShadowLayer}" />
        <Border Style="{StaticResource Chrome.Shell}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ── Titelzeile  ────────────────────────────────────────  -->
                <Grid Grid.Row="0" MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Die Ampel links oben, wie unter macOS: rot schließt, gelb verkleinert.  -->
                    <StackPanel
                        Grid.Column="0"
                        Margin="17,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="OnCloseSettings"
                            Content="✕"
                            Style="{StaticResource Chrome.Close}"
                            ToolTip="Schließen (Esc)" />
                        <Button
                            Click="OnMinimize"
                            Content="–"
                            Style="{StaticResource Chrome.Button}"
                            ToolTip="Verkleinern" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <Control
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Style="{StaticResource Mark}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Title}"
                            Text="AIlight" />
                        <TextBlock
                            Margin="10,1,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="Einstellungen" />
                    </StackPanel>
                </Grid>

                <!--  ── Navigation und Seite  ──────────────────────────────  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="214" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Separator}"
                        BorderThickness="0,1,1,0">
                        <DockPanel Margin="8,10,8,10">
                            <TextBlock
                                x:Name="NavVersion"
                                DockPanel.Dock="Bottom"
                                Margin="12,10,12,0"
                                Style="{StaticResource Caption}"
                                Text="" />

                            <StackPanel>
                                <ToggleButton
                                    x:Name="NavKonto"
                                    Click="OnNavClick"
                                    Content="Konto"
                                    IsChecked="True"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="konto" />
                                <ToggleButton
                                    x:Name="NavModell"
                                    Click="OnNavClick"
                                    Content="Modell"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="modell" />
                                <ToggleButton
                                    x:Name="NavChat"
                                    Click="OnNavClick"
                                    Content="Gespräch"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="gespraech" />
                                <ToggleButton
                                    x:Name="NavVerhalten"
                                    Click="OnNavClick"
                                    Content="Verhalten"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="verhalten" />
                                <ToggleButton
                                    x:Name="NavAussehen"
                                    Click="OnNavClick"
                                    Content="Aussehen"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="aussehen" />
                                <ToggleButton
                                    x:Name="NavVerlauf"
                                    Click="OnNavClick"
                                    Content="Verlauf"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="verlauf" />
                                <ToggleButton
                                    x:Name="NavAbout"
                                    Click="OnNavClick"
                                    Content="Über"
                                    Style="{StaticResource Nav.Item}"
                                    Tag="ueber" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer
                        x:Name="PageScroll"
                        Grid.Column="1"
                        Padding="22,16,18,20"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>

                            <!--  ══ Konto ══════════════════════════════════  -->
                            <StackPanel x:Name="PageKonto">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="AIlight rechnet nicht selbst: es fragt ein Modell. Welcher Anbieter das ist, wählst du hier — lokal laufende Modelle brauchen nicht einmal einen Schlüssel." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Anbieter" />
                                            <ComboBox
                                                x:Name="ProviderBox"
                                                Grid.Column="1"
                                                SelectionChanged="OnProviderChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ProviderInfoText"
                                            Margin="164,8,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Adresse" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Leer lassen für die Standardadresse." />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="BaseUrlBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                LostFocus="OnControlChanged"
                                                Style="{StaticResource Field.Text}" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="BaseUrlHint"
                                            Margin="164,8,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Wartezeit" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Wie lange auf die erste Antwort gewartet wird." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="TimeoutSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="600"
                                                Minimum="10"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="TimeoutValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Versuche" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Wiederholungen bei „zu viele Anfragen“ oder Serverfehlern." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="RetrySlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="6"
                                                Minimum="1"
                                                SmallChange="1"
                                                Style="{StaticResource Slider.Slim}"
                                                TickFrequency="1"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="RetryValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Title}" Text="Schlüssel" />
                                        <TextBlock
                                            x:Name="KeyHint"
                                            Margin="0,6,0,10"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="API-Schlüssel" />
                                            <PasswordBox
                                                x:Name="KeyBox"
                                                Grid.Column="1"
                                                Style="{StaticResource Field.Secret}" />
                                        </Grid>
                                        <WrapPanel Margin="164,10,0,0">
                                            <Button
                                                Click="OnSaveKey"
                                                Content="Schlüssel speichern"
                                                Style="{StaticResource Button.Primary}" />
                                            <Button
                                                x:Name="TestKeyButton"
                                                Click="OnTestKey"
                                                Content="Schlüssel testen"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                Click="OnOpenKeys"
                                                Content="Schlüssel erstellen"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                x:Name="LoadModelsButton"
                                                Click="OnLoadModels"
                                                Content="Modelle laden"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                Click="OnDeleteKey"
                                                Content="Entfernen"
                                                Style="{StaticResource Button.Danger}" />
                                        </WrapPanel>
                                        <TextBlock
                                            x:Name="KeyStatus"
                                            Margin="164,10,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <TextBlock
                                            x:Name="ModelStatus"
                                            Margin="164,6,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,6" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="Der Schlüssel liegt im Windows-Anmeldeinformationsspeicher — in keiner Datei und in keinem Protokoll. Jeder Anbieter hat seinen eigenen Eintrag; ein Wechsel lässt die anderen unangetastet. „Schlüssel erstellen“ öffnet die Seite des gewählten Anbieters." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Title}" Text="Was AIlight niemals tut" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource Subtitle}"
                                            Text="Keine Anmeldung bei AIlight, kein Konto, keine Zwischenstation: die Frage geht von diesem Rechner direkt an den gewählten Anbieter. Der Verlauf bleibt lokal." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Modell ═════════════════════════════════  -->
                            <StackPanel x:Name="PageModell" Visibility="Collapsed">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="Welches Modell antwortet — und wie ausführlich." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Modell" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="„Automatisch“ nimmt das schnelle Modell und bei längeren Fragen das stärkere." />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ModelBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                SelectionChanged="OnModelChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="ModelInfoText"
                                            Margin="164,8,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Eigener Modellname" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Überschreibt die Auswahl — für Modelle, die hier noch nicht stehen." />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="ModelNameBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                LostFocus="OnModelNameChanged"
                                                Style="{StaticResource Field.Text}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Antwortlänge" />
                                            <ComboBox
                                                x:Name="LengthBox"
                                                Grid.Column="1"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Denk-Aufwand" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Wie lange das Modell vor der Antwort nachdenkt." />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ReasoningBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Temperatur" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Niedrig = sachlich und gleichbleibend, hoch = einfallsreicher." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="TempSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="2"
                                                Minimum="0"
                                                SmallChange="0.1"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="TempValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Top-P" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="1 = alle Wörter erlaubt. Wird nur gesendet, wenn der Regler darunter steht." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="TopPSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="1"
                                                Minimum="0.05"
                                                SmallChange="0.05"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="TopPValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Höchstlänge" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Obergrenze in Tokens. Leer oder 0 = aus der Stufe oben." />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="MaxTokensBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                LostFocus="OnControlChanged"
                                                Style="{StaticResource Field.Text}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <CheckBox
                                            x:Name="StreamingCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Antwort Stück für Stück zeigen (Strom)"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="ThinkingExtCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Erweiterte Denk-Schritte ausdrücklich anfordern"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="WebSearchCheck"
                                            Checked="OnControlChanged"
                                            Content="Websuche erlauben (nur bei Anbietern, die sie anbieten)"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Title}" Text="System-Prompt" />
                                        <TextBlock
                                            Margin="0,4,0,8"
                                            Style="{StaticResource Caption}"
                                            Text="Wird jeder Frage vorangestellt. Leer lassen für den eingebauten Standard." />
                                        <TextBox
                                            x:Name="PromptBox"
                                            LostFocus="OnControlChanged"
                                            Style="{StaticResource Field.Multiline}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Gespräch ═══════════════════════════════  -->
                            <StackPanel x:Name="PageChat" Visibility="Collapsed">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="Wie viel AIlight sich merkt — und was mitgesendet wird." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Runden im Gedächtnis" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Nur diese letzten Frage-Antwort-Paare gehen bei einer neuen Frage mit." />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="MemoryBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Einträge im Verlauf" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Ältere Antworten fallen weg, sobald die Liste voll ist." />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="HistoryBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <CheckBox
                                            x:Name="ClearInputCheck"
                                            Margin="0,0,0,12"
                                            Checked="OnControlChanged"
                                            Content="Eingabefeld nach dem Senden leeren"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <WrapPanel>
                                            <Button
                                                Click="OnClearConversation"
                                                Content="Gespräch jetzt leeren"
                                                Style="{StaticResource Button.Ghost}" />
                                        </WrapPanel>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="Der Verlauf bleibt dabei erhalten — nur das Kurzzeitgedächtnis wird leer." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Title}" Text="Nachsehen" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource Subtitle}"
                                            Text="Der Befehl /conversation zeigt genau, was gerade mitgesendet würde." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Verhalten ══════════════════════════════  -->
                            <StackPanel x:Name="PageVerhalten" Visibility="Collapsed">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="Wie sich die Leiste verhält." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Hotkey" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Ins Feld klicken und die Kombination drücken." />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="HotkeyBox"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                IsReadOnly="True"
                                                PreviewKeyDown="OnHotkeyBoxKeyDown"
                                                Style="{StaticResource Field.Text}" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="HotkeyStatus"
                                            Margin="164,10,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="Zum Beispiel Strg+Alt+K oder Alt+Space." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,10"
                                            Style="{StaticResource Title}"
                                            Text="Start und Verhalten" />
                                        <CheckBox
                                            x:Name="StartCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Mit Windows starten"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="PreloadCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Leiste im Hintergrund vorbereiten (erster Aufruf sofort da)"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="HideCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Leiste schließen, wenn der Fokus verloren geht"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <TextBlock
                                            Margin="0,-6,0,12"
                                            Style="{StaticResource Caption}"
                                            Text="Unabhängig davon tritt die Leiste immer zurück, wenn sich die Einstellungen öffnen — sie schwebt nie davor." />
                                        <CheckBox
                                            x:Name="LogCheck"
                                            Checked="OnControlChanged"
                                            Content="Protokolldatei schreiben (nur Ereignisse und Fehler)"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Vorschläge" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Wie viele Zeilen die Liste höchstens zeigt (0 = keine)." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="SuggestionSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="12"
                                                Minimum="0"
                                                SmallChange="1"
                                                Style="{StaticResource Slider.Slim}"
                                                TickFrequency="1"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="SuggestionValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <CheckBox
                                            x:Name="CompactCheck"
                                            Checked="OnControlChanged"
                                            Content="Kompakte Zeilen in der Vorschlagsliste"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <WrapPanel>
                                            <Button
                                                Click="OnOpenLog"
                                                Content="Protokoll ansehen"
                                                Style="{StaticResource Button.Ghost}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,8"
                                            Style="{StaticResource Title}"
                                            Text="Einführung" />
                                        <TextBlock
                                            Margin="0,0,0,12"
                                            Style="{StaticResource Subtitle}"
                                            Text="Die Einführung mit den sieben Schritten läuft beim ersten Start einmal von selbst. Hier lässt sie sich jederzeit wieder ansehen." />
                                        <WrapPanel>
                                            <Button
                                                x:Name="WelcomeButton"
                                                Click="OnOpenWelcome"
                                                Content="Einführung anzeigen"
                                                Style="{StaticResource Button.Ghost}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Aussehen ═══════════════════════════════  -->
                            <StackPanel x:Name="PageAussehen" Visibility="Collapsed">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="Farben und Maße der Leiste — jede Änderung wirkt sofort." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,12"
                                            Style="{StaticResource Title}"
                                            Text="Vorschau" />
                                        <Border
                                            x:Name="PreviewCard"
                                            Width="420"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <StackPanel>
                                                <Grid Height="46">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.Selection}"
                                                        CornerRadius="9">
                                                        <Control
                                                            Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource Mark}" />
                                                    </Border>
                                                    <TextBlock
                                                        x:Name="PreviewText"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="17"
                                                        Foreground="{DynamicResource Brush.Muted}"
                                                        Text="Frage stellen — oder /help" />
                                                    <TextBlock
                                                        x:Name="PreviewMeta"
                                                        Grid.Column="2"
                                                        Margin="8,0,16,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource Brush.Muted}"
                                                        Text="20b · 0,4 s" />
                                                </Grid>
                                                <Border
                                                    Background="{DynamicResource Brush.Code}"
                                                    CornerRadius="0,0,13,13"
                                                    Height="24">
                                                    <TextBlock
                                                        x:Name="PreviewHint"
                                                        Margin="14,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource Brush.Muted}"
                                                        Text="Enter fragt · Strg+, Einstellungen · Esc schließt" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="Breite, Schriftgröße und Deckkraft wirken hier sofort mit." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Farben" />
                                            <ComboBox
                                                x:Name="ThemeBox"
                                                Grid.Column="1"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top" Style="{StaticResource Label}" Text="Akzentfarbe" />
                                            <WrapPanel
                                                x:Name="AccentPanel"
                                                Grid.Column="1"
                                                Margin="0,2,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,10"
                                            Style="{StaticResource Title}"
                                            Text="Form und Schrift" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Ecken-Radius" />
                                            <Slider
                                                x:Name="CornerSlider"
                                                Grid.Column="1"
                                                Maximum="22"
                                                Minimum="8"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="CornerValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Schrift" />
                                            <ComboBox
                                                x:Name="FontBox"
                                                Grid.Column="1"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Schrift im Code" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="Gilt für Codeblöcke in der Antwort." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="CodeFontSlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="20"
                                                Minimum="10"
                                                SmallChange="1"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="CodeFontValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,2,0,10"
                                            Style="{StaticResource Title}"
                                            Text="Bewegung und Antwort" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Label}" Text="Stärke der Bewegung" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    Style="{StaticResource Caption}"
                                                    Text="1 = Haus. Weniger = ruhiger, mehr = lebhafter. Gilt für jedes Fenster." />
                                            </StackPanel>
                                            <Slider
                                                x:Name="AnimIntensitySlider"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Maximum="1.6"
                                                Minimum="0.5"
                                                SmallChange="0.05"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="AnimIntensityValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <CheckBox
                                            x:Name="AnimateCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Leiste einblenden und Impuls animieren"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="ThinkingCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Denk-Schritte automatisch aufklappen"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="MetaCheck"
                                            Margin="0,0,0,10"
                                            Checked="OnControlChanged"
                                            Content="Fußzeile mit Modell, Tokens und Kosten zeigen"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                        <CheckBox
                                            x:Name="ShadowCheck"
                                            Checked="OnControlChanged"
                                            Content="Weicher Schatten unter der Leiste"
                                            Style="{StaticResource Switch}"
                                            Unchecked="OnControlChanged" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Breite" />
                                            <Slider
                                                x:Name="WidthSlider"
                                                Grid.Column="1"
                                                Maximum="1200"
                                                Minimum="420"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="WidthValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Abstand von oben" />
                                            <Slider
                                                x:Name="TopSlider"
                                                Grid.Column="1"
                                                Maximum="40"
                                                Minimum="0"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="TopValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Schriftgröße" />
                                            <Slider
                                                x:Name="FontSlider"
                                                Grid.Column="1"
                                                Maximum="28"
                                                Minimum="12"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="FontValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                        <Border Style="{StaticResource Line}" Margin="0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Deckkraft" />
                                            <Slider
                                                x:Name="OpacitySlider"
                                                Grid.Column="1"
                                                Maximum="1"
                                                Minimum="0.6"
                                                Style="{StaticResource Slider.Slim}"
                                                ValueChanged="OnSliderChanged" />
                                            <TextBlock
                                                x:Name="OpacityValue"
                                                Grid.Column="2"
                                                Style="{StaticResource Value}"
                                                Text="" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Verlauf ════════════════════════════════  -->
                            <StackPanel x:Name="PageVerlauf" Visibility="Collapsed">
                                <TextBlock
                                    Margin="2,0,0,10"
                                    Style="{StaticResource Subtitle}"
                                    Text="Jede Frage wird lokal mitgeschrieben — hier bestimmst du, wie lange." />

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="Aufbewahrung" />
                                            <ComboBox
                                                x:Name="KeepBox"
                                                Grid.Column="1"
                                                SelectionChanged="OnControlChanged"
                                                Style="{StaticResource Box.Select}" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="StatsText"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <WrapPanel>
                                            <Button
                                                Click="OnOpenDataFolder"
                                                Content="Ordner öffnen"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                Click="OnClearHistory"
                                                Content="Verlauf löschen"
                                                Style="{StaticResource Button.Danger}" />
                                        </WrapPanel>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="Diese Datei liegt in deinem Benutzerprofil und überlebt eine Neuinstallation." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ══ Über ═══════════════════════════════════  -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Control
                                                Width="22"
                                                Height="22"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Mark}" />
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Title}"
                                                Text="AIlight" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="AboutText"
                                            Margin="0,10,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="" />
                                        <Border Style="{StaticResource Line}" Margin="0,12,0,10" />
                                        <WrapPanel>
                                            <Button
                                                Click="OnOpenRepo"
                                                Content="Projekt auf GitHub"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                Click="OnOpenDataFolder"
                                                Content="Einstellungsordner"
                                                Style="{StaticResource Button.Ghost}" />
                                            <Button
                                                Click="OnOpenLog"
                                                Content="Protokoll ansehen"
                                                Style="{StaticResource Button.Ghost}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
