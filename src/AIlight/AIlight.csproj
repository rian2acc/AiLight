<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF-Leiste + WinForms nur für das Infobereich-Symbol (Tray) — beides im SDK enthalten. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Eigene globale Usings statt der Vorlagen: WPF und WinForms (nur Tray) importieren
         sonst beide ihre eigenen Typen und der Compiler wird mehrdeutig. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>AIlight</AssemblyName>
    <RootNamespace>AIlight</RootNamespace>
    <Version>3.0.0</Version>
    <Company>AIlight</Company>
    <Product>AIlight</Product>
    <Description>KI-Leiste für Windows — Hotkey, Frage, gestreamte Antwort</Description>
    <!-- Vollständige Angaben in der Datei: Windows, Virenschutz-Programme und die
         Dateieigenschaften lesen sie. Ein Programm ohne Hersteller und Copyright
         sieht für eine Heuristik namenloser aus als eines mit. -->
    <Copyright>Copyright (C) 2026 AIlight</Copyright>
    <Authors>rian2acc</Authors>
    <PackageProjectUrl>https://github.com/rian2acc/AiLight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rian2acc/AiLight</RepositoryUrl>
    <NeutralLanguage>de</NeutralLanguage>
    <ApplicationIcon>..\..\packaging\ailight.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- Eine Leiste, die im Infobereich wartet, soll so wenig wie möglich halten:
         kein Hintergrund-GC-Thread, keine Arbeits-Threads auf Vorrat. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <ThreadPoolMinThreads>2</ThreadPoolMinThreads>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Nur eine Warnstufe: unbenutzte Felder usw. nicht als Fehler behandeln. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
