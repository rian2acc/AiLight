<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Alles Sichtbare an einer Stelle — angelehnt an macOS: ruhige Flächen,
      Haarlinien statt kräftiger Rahmen, großzügige Eckenradien, ein Akzent.
      Die Farben und Radien setzt Theme.Apply() beim Start und bei jeder
      Änderung; deshalb steht überall DynamicResource — so wirkt ein Wechsel
      von Hell/Dunkel, Akzentfarbe oder Eckenradius sofort in allen Fenstern.
    -->

    <!--  ── Farben (Standardwerte = dunkles Thema) ─────────────────────────  -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#F02A2A2C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#FF98989D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#330A84FF" />
    <SolidColorBrush x:Key="Brush.Code" Color="#80000000" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF453A" />
    <SolidColorBrush x:Key="Brush.Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Track" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Brush.Field" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.FieldBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="Brush.Ring" Color="#590A84FF" />
    <SolidColorBrush x:Key="Brush.Traffic.Red" Color="#FFFF5F57" />
    <SolidColorBrush x:Key="Brush.Traffic.Yellow" Color="#FEBC2E" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--  ── Schrift ─────────────────────────────────────────────────────────  -->
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--  ── Flächen ─────────────────────────────────────────────────────────  -->
    <!--  Eine Karte: das Grundelement jeder Einstellungsseite.  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="Line" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Separator}" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Code}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Field}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!--  ── Fensterrahmen ───────────────────────────────────────────────────  -->
    <!--  Nur der Schatten; der Inhalt liegt darüber, damit Schrift scharf bleibt.  -->
    <Style x:Key="Chrome.ShadowLayer" TargetType="Border">
        <Setter Property="Background" Value="#01000000" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Shell}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="24"
                    Color="#000000"
                    Opacity="0.40"
                    ShadowDepth="4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chrome.Shell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Shell}" />
    </Style>

    <!--
      Die „Ampel“ links oben, wie unter macOS: rot schließt, gelb verkleinert.
      Das Zeichen erscheint erst beim Überfahren; der Kreis dunkelt leicht nach.
    -->
    <Style x:Key="Chrome.Button" TargetType="Button">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Traffic.Yellow}" />
        <Setter Property="Foreground" Value="#99000000" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#33000000"
                            BorderThickness="1"
                            CornerRadius="7" />
                        <ContentPresenter
                            x:Name="Glyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            <Setter TargetName="Shell" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Chrome.Close"
        BasedOn="{StaticResource Chrome.Button}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Traffic.Red}" />
        <Setter Property="Foreground" Value="#8A0000" />
    </Style>

    <!--  ── Knöpfe ──────────────────────────────────────────────────────────  -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Shell"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Field}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Button.Primary"
        BasedOn="{StaticResource Button.Ghost}"
        TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Shell"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="{DynamicResource Radius.Field}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Button.Danger"
        BasedOn="{StaticResource Button.Ghost}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Kopfzeile der Leiste: kleine, textlose Knöpfe  -->
    <Style
        x:Key="Bar.Button"
        BasedOn="{StaticResource Button.Ghost}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  ── Navigation der Einstellungen ────────────────────────────────────  -->
    <Style x:Key="Nav.Item" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Shell"
                        Background="Transparent"
                        CornerRadius="{DynamicResource Radius.Field}"
                        Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="Marker"
                                Width="3"
                                Margin="0,0,9,0"
                                Background="Transparent"
                                CornerRadius="2" />
                            <ContentPresenter
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                TextBlock.FontFamily="{DynamicResource Font.Ui}"
                                TextBlock.FontSize="13" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Ein Eintrag der Vorschlagsliste  -->
    <Style x:Key="Suggest.Row" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Row}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="Suggest.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Suggest.Subtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>

    <Style x:Key="Suggest.Glyph" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!--  ── Eingabefelder ───────────────────────────────────────────────────  -->
    <Style x:Key="Field.Text" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Shell"
                        Background="{DynamicResource Brush.Field}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Field}">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Field.Multiline"
        BasedOn="{StaticResource Field.Text}"
        TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MinHeight" Value="92" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Shell"
                        Background="{DynamicResource Brush.Field}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Field}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field.Secret" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="Shell"
                        Background="{DynamicResource Brush.Field}"
                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Field}">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ── Auswahlliste ────────────────────────────────────────────────────  -->
    <Style x:Key="Box.Item" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Shell"
                        Margin="4,1"
                        Background="Transparent"
                        CornerRadius="6"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Box.Select" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Box.Item}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="Toggle"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="Shell"
                                        Background="{DynamicResource Brush.Field}"
                                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Field}">
                                        <TextBlock
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{DynamicResource Brush.Muted}"
                                            Text="▾" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            Margin="11,0,30,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="280"
                                Margin="0,4,0,0"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Card}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="16"
                                        Color="#000000"
                                        Opacity="0.32"
                                        ShadowDepth="3" />
                                </Border.Effect>
                                <ScrollViewer Margin="4,6" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ── Schalter (Kästchen als Schiebeschalter) ─────────────────────────  -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="Track"
                            Width="38"
                            Height="22"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Track}"
                            CornerRadius="11">
                            <Border
                                x:Name="Knob"
                                Width="16"
                                Height="16"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Muted}"
                                CornerRadius="8" />
                        </Border>
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="11,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Background" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Farbfeld für die Akzentfarbe  -->
    <Style x:Key="Swatch" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,9,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="Ring"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10" />
                        <Border
                            x:Name="Face"
                            Margin="3"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ── Regler ──────────────────────────────────────────────────────────  -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        Height="5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Rest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border
                        Height="5"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Track}"
                        CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Knob" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid VerticalAlignment="Center">
                        <Ellipse
                            Width="14"
                            Height="14"
                            Fill="#FFFFFFFF" />
                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{DynamicResource Brush.Accent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Slim" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border
                            Height="5"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Track}"
                            CornerRadius="3" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Slider.Fill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Knob}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Slider.Rest}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ── Schlanker Scrollbalken (überall) ───────────────────────────────  -->
    <Style x:Key="Scrollbar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Background="{DynamicResource Brush.Track}"
                        CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Margin="2,0" Style="{StaticResource Scrollbar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
